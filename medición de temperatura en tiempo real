import pyvisa
import numpy as np
import matplotlib.pyplot as plt

# --- CONFIGURACIÓN DE LA CONEXIÓN ---
rm = pyvisa.ResourceManager()
resources = rm.list_resources()
print("Instrumentos encontrados:", resources)

# Ajusta esta línea si tu osciloscopio aparece con otro nombre
scope = rm.open_resource(resources[0])
scope.timeout = 10000  # ms

# --- IDENTIFICACIÓN ---
idn = scope.query("*IDN?")
print("Conectado a:", idn)

# --- CONFIGURACIÓN DEL CANAL Y FORMATO DE DATOS ---
scope.write("DATA:SOURCE CH1")
scope.write("DATA:ENC RPB")  # Datos binarios
scope.write("DATA:WIDTH 1")  # 1 byte por punto

# --- OBTENER PARÁMETROS DE ESCALA ---
ymult = float(scope.query("WFMPRE:YMULT?"))
yzero = float(scope.query("WFMPRE:YZERO?"))
yoff = float(scope.query("WFMPRE:YOFF?"))
xincr = float(scope.query("WFMPRE:XINCR?"))

# --- SOLICITAR DATOS BINARIOS ---
scope.write("CURVE?")
raw = scope.read_raw()

# Los primeros 2 bytes son el encabezado del bloque (#45000...)
header_len = 2 + int(raw[1:2])
data_start = header_len
data = np.frombuffer(raw[data_start:-1], dtype=np.uint8)

# --- CONVERTIR A VOLTAJE Y TIEMPO ---
voltage = (data - yoff) * ymult + yzero
time = np.arange(0, len(voltage)) * xincr

# --- MOSTRAR LOS DATOS EN CONSOLA ---
print("Datos recibidos:", len(voltage), "puntos")
print("Primeros 10 valores de voltaje:", voltage[:10])

# --- GRAFICAR ---
plt.plot(time, voltage)
plt.title("CH1 - Señal del osciloscopio")
plt.xlabel("Tiempo [s]")
plt.ylabel("Voltaje [V]")
plt.grid(True)
plt.show()

scope.close()

```
